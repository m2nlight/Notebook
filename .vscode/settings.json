{
    "foam.edit.linkReferenceDefinitions": "withExtensions",
    "markdown.copyFiles.destination": {
        "**/*": "${documentWorkspaceFolder}/assets/${documentBaseName}/${unixTime}.${fileExtName}"
    },
    "[markdown]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.quickSuggestions": {
            "comments": "on",
            "strings": "on",
            "other": "on"
        },
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file",
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "better-todo-tree.highlights.customHighlight": {
        "[ ]": {
            "borderRadius": "4px",
            "background": "#80000080",
            "foreground": "#FF00FF80"
        },
        "[x]": {
            "borderRadius": "4px",
            "background": "#00800080",
            "foreground": "#00FFFF",
        }
    },
    "better-todo-tree.highlights.useColourScheme": true,
    "better-todo-tree.regex.regexCaseSensitive": false,
    "editor.codeActionsOnSave": {
        "source.organizeLinkDefinitions": "never",
    }
}